/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Personal Genome Pipeline — Base resource configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource defaults for each process label. Tuned for consumer hardware (16 cores, 64 GB).
    Override in profile-specific configs or with --max_cpus / --max_memory.

    Resources are capped at the configured maximums via the `resourceLimits`
    directive (Nextflow >= 24.04). This replaces the legacy `check_max()`
    helper function, which the strict config parser no longer allows.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Every task script runs with pipefail. Nextflow's default is `bash -ue`,
    // where only the last command of a pipe counts: a truncated input to
    // `bcftools view ... | bcftools +split-vep ...` gave a short, valid output
    // and a green task. A script that starts with its own #! line keeps it.
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Cap every process at the configured maximums (replaces check_max()).
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time
    ]

    // Defaults
    cpus   = 2
    memory = { 4.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    // Exit codes that usually mean "killed for memory or time" are retried
    // once, with memory and time doubled (task.attempt = 2); resourceLimits
    // above still caps the doubled request.
    errorStrategy = { task.exitStatus in [143,137,104,134,139,247] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resources by label
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
}
