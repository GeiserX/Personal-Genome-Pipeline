/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Personal Genome Pipeline — Base resource configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource defaults for each process label, then the processes whose
    request follows its numbered script instead of its label. The largest
    request is 8 CPUs and 32 GB, whatever the host. Override in a config
    passed with -c, or lower with --max_cpus / --max_memory / --max_time.

    Resources are capped at the configured maximums via the `resourceLimits`
    directive (Nextflow >= 24.04). This replaces the legacy `check_max()`
    helper function, which the strict config parser no longer allows.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Every task script runs with pipefail. Nextflow's default is `bash -ue`,
    // where only the last command of a pipe counts: a truncated input to
    // `bcftools view ... | bcftools +split-vep ...` gave a short, valid output
    // and a green task. A script that starts with its own #! line keeps it.
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Cap every process at the configured maximums (replaces check_max()).
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time
    ]

    // Defaults
    cpus   = 2
    memory = { 4.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    // Exit codes that usually mean "killed for memory or time" are retried
    // once, with memory and time doubled (task.attempt = 2); resourceLimits
    // above still caps the doubled request.
    errorStrategy = { task.exitStatus in [143,137,104,134,139,247] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resources by label
    withLabel: 'process_single' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // Per-process requests. A withName block wins over withLabel, so these
    // replace the label's values; a label in the module would not. Memory
    // stays a closure times task.attempt, so the retry on exit 137 still
    // doubles it (resourceLimits caps the doubled value).

    // DeepVariant is one task. In one observed ~30x run on 8 CPUs it took
    // about 13.5 h, and on a busy host make_examples ran at about half that
    // speed, so a busy or smaller host can pass 24 h. On Nextflow 26.04.7
    // a task that runs past its time limit can stop the whole run instead
    // of being retried (nextflow-io/nextflow#7569, fixed upstream after
    // 26.04.7; read in the source, not reproduced). So the first attempt
    // gets the full --max_time (default 48.h). A hung DeepVariant runs that
    // long before it is stopped. It keeps the label's 8 CPUs (8 shards):
    // its memory at 16 shards has not been measured. To give it more, pass
    // -c with withName: 'DEEPVARIANT' { cpus = 16 }, or run
    // scripts/03-deepvariant.sh with THREADS=16.
    withName: 'DEEPVARIANT' {
        time   = { params.max_time }
    }

    // Steps 01b and 02 run fastp and samtools sort/markdup with THREADS
    // (default 8) CPUs and sort/markdup with THREADS + 4 GB. fastp, sort
    // and markdup use the threads; gzip -dc stays on one.
    withName: 'FASTP' {
        cpus   = 8
    }
    withName: 'ALIGN_MARKDUP' {
        cpus   = 8
        memory = { 1.GB * (task.cpus + 4) * task.attempt }
    }

    // What steps 04, 18 and 13 give these tools: Manta 16 GB, CNVpytor
    // 4 CPUs and 8 GB (its -j follows task.cpus, -j 4 as in step 18), VEP
    // 16 GB (step 13 at THREADS=8: 2 GB per fork). The label's 32 GB took
    // the whole memory pool of a 32 GB host, so nothing could run beside them.
    withName: 'MANTA' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'CNVPYTOR' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    withName: 'VEP' {
        memory = { 16.GB * task.attempt }
    }
}
