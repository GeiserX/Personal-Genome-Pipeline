/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for a stub run of every tool
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow run main.nf -profile test_all -stub

    The test profile plus every tool main.nf accepts in --tools, with each
    database parameter pointed at an empty file or directory under
    assets/stub/db, so every process is instantiated. The samplesheet has one
    row per starting point (VCF+BAM, FASTQ, BAM only), so the alignment and
    calling processes run too. The stubs only touch
    files, so no container engine is needed. Run it from the repository
    root: the samplesheet paths are relative to it.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'All-tools stub profile'
    config_profile_description = 'Every tool, every process, empty stub databases'

    tools = 'pharmcat,cpic,clinvar,pypgx,vep,vcfanno,slivar,clinical_filter,cpsr,roh,prs,ancestry,mito_haplogroup,hla_typing,expansion_hunter,stranger,telomere_hunter,mosdepth,mito_variants,cyrius,manta,delly,cnvpytor,duphold,annotsv,survivor_merge,html_report,multiqc'

    vep_cache           = "${projectDir}/assets/stub/db/vep_cache"
    vep_cache_cpsr      = "${projectDir}/assets/stub/db/vep_cache_cpsr"
    pcgr_data           = "${projectDir}/assets/stub/db/pcgr_data"
    pypgx_bundle        = "${projectDir}/assets/stub/db/pypgx_bundle"
    cnvpytor_resources  = "${projectDir}/assets/stub/db/cnvpytor_resources"
    annotsv_annotations = "${projectDir}/assets/stub/db/annotsv_annotations"
    pgs_scoring         = "${projectDir}/assets/stub/db/pgs_scoring"
    clinvar             = "${projectDir}/assets/stub/db/clinvar.vcf.gz"
    clinvar_index       = "${projectDir}/assets/stub/db/clinvar.vcf.gz.tbi"
    revel               = "${projectDir}/assets/stub/db/revel.tsv.gz"
    revel_index         = "${projectDir}/assets/stub/db/revel.tsv.gz.tbi"
    ancestry_ref        = "${projectDir}/assets/stub/db/ancestry_ref.vcf.gz"
    expansion_catalog   = "${projectDir}/assets/stub/db/catalog.json"
    hla_dat             = "${projectDir}/assets/stub/db/hla.dat"
    hla_genes           = "${projectDir}/assets/stub/db/gencode_genes.gtf"
    gnomad_constraint   = "${projectDir}/assets/stub/db/gnomad_constraint.tsv"
}
