#!/usr/bin/env bash
# docker shim for the e2e job: clamps --cpus to the CPUs this machine has.
#
# Many steps ask for `--cpus 8`; docker refuses any value above the host's CPU
# count ("Range of CPUs is from 0.01 to 4.00"), so on a 4-CPU runner those
# steps would fail before the tool starts. Everything else passes through.
set -euo pipefail

self_dir="$(cd "$(dirname "$0")" && pwd)"
real=""
IFS=: read -r -a path_dirs <<< "$PATH"
for d in "${path_dirs[@]}"; do
  [ "$d" = "$self_dir" ] && continue
  if [ -x "${d}/docker" ]; then real="${d}/docker"; break; fi
done
[ -n "$real" ] || { echo "docker shim: no real docker on PATH" >&2; exit 127; }

# E2E_LAZY_IMAGES (set by scripts/ci/e2e-run.sh): images pulled at first use.
# A `docker run` or `docker create` of one that is not here pulls it first,
# with e2e-run.sh's retry on a registry 5xx.
if [ -n "${E2E_LAZY_IMAGES:-}" ] && { [ "${1:-}" = run ] || [ "${1:-}" = create ]; }; then
  for a in "$@"; do
    [[ " ${E2E_LAZY_IMAGES} " == *" ${a} "* ]] || continue
    "$real" image inspect "$a" > /dev/null 2>&1 && continue
    "$(dirname "$self_dir")/../../scripts/ci/e2e-run.sh" --pull-image "$a" >&2 || exit $?
  done
fi

max=$(nproc)
clamp() { awk -v v="$1" -v m="$max" 'BEGIN {print (v + 0 > m) ? m : v}'; }

args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --cpus)   args+=(--cpus "$(clamp "$2")"); shift 2 ;;
    --cpus=*) args+=("--cpus=$(clamp "${1#--cpus=}")"); shift ;;
    *)        args+=("$1"); shift ;;
  esac
done
exec "$real" "${args[@]}"
