#!/usr/bin/env bash
# Fake `wget` for scripts/ci/run-fake-docker-suite.sh: never touches the
# network. Writes the body from download-body.sh to the file wget would have
# written (-O FILE, -P DIR, or the URL's base name) and logs the call to
# $FAKE_DOCKER_LOG. A URL that matches the regex in FAKE_DOWNLOAD_FAIL exits 8
# (wget's "server error" code) and writes nothing.
set -uo pipefail
# hide_commands (lib.sh) calls this script through a symlink in another
# directory; the body helper lives next to the real file.
self=$0
while [ -L "$self" ]; do self=$(readlink "$self"); done
# shellcheck source=download-body.sh
. "$(dirname "$self")/download-body.sh"

LOG=${FAKE_DOCKER_LOG:-/dev/null}
out="" dir="." url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -O|--output-document) out=${2:-}; shift 2 ;;
    --output-document=*) out=${1#*=}; shift ;;
    -P|--directory-prefix) dir=${2:-.}; shift 2 ;;
    --directory-prefix=*) dir=${1#*=}; shift ;;
    -t|--tries|-T|--timeout|-U|--user-agent|--header) shift 2 ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
printf 'wget %s -> %s\n' "$url" "${out:-${dir}/$(basename "$url")}" >> "$LOG"

if [ -z "$url" ]; then
  echo "wget: missing URL" >&2
  exit 1
fi
if [ -n "${FAKE_DOWNLOAD_FAIL:-}" ] && [[ "$url" =~ $FAKE_DOWNLOAD_FAIL ]]; then
  echo "fake wget: refusing ${url} (FAKE_DOWNLOAD_FAIL)" >&2
  exit 8
fi
if [ "$out" = "-" ]; then
  fake_body "$url"
else
  [ -n "$out" ] || out="${dir}/$(basename "$url")"
  fake_body "$url" > "$out"
fi
