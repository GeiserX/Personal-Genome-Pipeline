# The viral genomes of step 47 (opt-in; `setup.sh --viral-data`): NCBI RefSeq
# records fetched by accession.version in this order from NCBI's E-utilities
# (efetch, FASTA) as one file, checked against the sha256 of that download.
# An accession.version never changes its sequence. HHV-6A, HHV-6B, EBV, CMV,
# HSV-1, HSV-2, VZV, HHV-7, HHV-8, HPV-16, -18, -6b, -11, HBV, HCV, HIV-1,
# HTLV-1, BK, JC and Merkel cell polyomaviruses, adenovirus 5, Torque teno
# virus 1, parvovirus B19 and phiX174 (Illumina's run control). Change the
# version, the list and the sha256 together.
VIRAL_REF_VERSION="1"
VIRAL_REF_ACCESSIONS="NC_001664.4,NC_000898.1,NC_007605.1,NC_006273.2,NC_001806.2,NC_001798.2,NC_001348.1,NC_001716.2,NC_009333.1,NC_001526.4,NC_001357.1,NC_001355.1,NC_001525.1,NC_003977.2,NC_004102.1,NC_001802.1,NC_001436.1,NC_001538.1,NC_001699.1,NC_010277.2,AC_000008.1,NC_002076.2,NC_000883.2,NC_001422.1"
VIRAL_REF_SHA256="0ab0907a11f04c74323d0a744e5572deb1a97df5fddf36357dbfe07fac5b93c5"
# The masked reference of setup.sh --masked-reference: the default no-ALT
# analysis set with the false duplications of GRCh38 the GRC lists set to N,
# the regions GIAB's maskedGRC_exclusions_v2 file and FixItFelix's v2
# reference mask. GRC_EXCLUSIONS_URL is GIAB's copy of the GRC list (12 rows,
# without the contamination rows), checked against GRC_EXCLUSIONS_SHA256;
# GRC_MASKED_REF_SHA256 is the sha256 of the masked FASTA built from NCBI's
# file. Change the three together.
GRC_EXCLUSIONS_URL="https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/references/GRCh38/GCA_000001405.15_GRCh38_GRC_exclusions_T2Tv2.bed"
GRC_EXCLUSIONS_SHA256="4fce8e4cdeee61656c9c75ddce41df7caffb3d20f09c4489e17047a7a12346c5"
GRC_MASKED_REF_SHA256="0471c903ed75d000f7260fb96064aad3f8b9a1e1bdd6d9f4128282bfa92ccfdf"

# The phasing panel of step 51 (opt-in; `setup.sh --mocha-data`): the 1000
# Genomes high-coverage phased panel (3,202 people, release 20220422) of EBI,
# one VCF per chromosome, each checked against the md5 of the release's
# manifest, whose sha256 is pinned here. The genetic map is the one of step
# 26b (ANCESTRY_FINE_MAP_SHA256). A new release changes the folder, so step 51
# reads the new one.
MOCHA_PANEL_VERSION="20220422"
MOCHA_PANEL_URL="https://ftp.1000genomes.ebi.ac.uk/vol1/ftp/data_collections/1000G_2504_high_coverage/working/20220422_3202_phased_SNV_INDEL_SV"
MOCHA_PANEL_MANIFEST_SHA256="71366add1f73a5a3283b8d89d5253f0b5b6e963032eb4a7e1862c19228c4579d"

# Exomiser's data (step 48, `setup.sh --exomiser-data`): the hg38 and phenotype
# archives of this data release, which EXOMISER_IMAGE 15.1.0 reads (the 2602
# release notes list 14.0.0 to 15.0.0; 15.1.0's notes name no data change). Exomiser
# publishes no checksum for them: each sha256 is of the archive as downloaded
# on 2026-10-25. Change the three together.
EXOMISER_DATA_VERSION="2602"
EXOMISER_HG38_SHA256="2ed14f8b63b5612068591648d8c3c6e34ce9d1c66c08a78990597f78031df447"  # 23,576,028,714 bytes
