# shellcheck shell=bash
# versions.env: every container image and every coupled data version the
# pipeline uses. Scripts read it through scripts/lib/common.sh; no script names
# an image or a data release itself, so a version bump is one line here.
#
# To bump a tool: change its line, then run ./scripts/setup.sh --pull-only.
# Lines marked `# optional` (alternative callers and aligners, the benchmark)
# are not pre-pulled by setup.sh nor checked by validate-setup.sh; docker pulls
# them the first time a step runs them. Keep every line NAME="value": several
# CI checks and Renovate read this file as text.
#
# Images whose publisher offers no versioned tags are pinned by digest
# (name@sha256:...) instead of a floating :latest. To refresh one:
#   docker manifest inspect -v <name>:latest | grep -m1 digest
#
# Holds and legacy tools are noted next to their pins. "legacy: no automated
# bumps" means the upstream is archived or quiet; bump it by hand after a test.

# --- Core tools ---
MINIMAP2_IMAGE="quay.io/biocontainers/minimap2:2.31--h118bc1c_0"
SAMTOOLS_IMAGE="staphb/samtools:1.24"
BCFTOOLS_IMAGE="staphb/bcftools:1.24"
DEEPVARIANT_IMAGE="google/deepvariant:1.10.0"
FASTP_IMAGE="quay.io/biocontainers/fastp:1.3.6--h43da1c4_0"  # hold: 1.3.7 waits for a normal suffixed biocontainer tag

# --- Alternative aligners and callers (optional) ---
BWAMEM2_IMAGE="quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0"  # optional: step 02a; 2.3 reads a 2.2.1 index (no index code changed between the two)
BWA_IMAGE="quay.io/biocontainers/bwa:0.7.19--h577a1d6_1"  # optional: classic BWA index for GRIDSS (step 04b)
FREEBAYES_IMAGE="quay.io/biocontainers/freebayes:1.3.10--h3752d28_1"  # optional: step 03b
STRELKA_IMAGE="quay.io/biocontainers/strelka:2.9.10--h9ee0642_1"  # optional: step 03c; legacy: no automated bumps
OCTOPUS_IMAGE="dancooke/octopus:0.7.4"  # optional: step 03d; legacy: no automated bumps
CLAIR3_IMAGE="hkubal/clair3:v2.0.4"  # optional: step 03e
TIDDIT_IMAGE="quay.io/biocontainers/tiddit:3.9.7--py312hfcd9dac_0"  # optional: step 04a
SNIFFLES_IMAGE="quay.io/biocontainers/sniffles:2.8.0--pyhdfd78af_1"  # optional: step 04c; hold: 2.8.1 waits for bioconda
HAPPY_IMAGE="jmcdani20/hap.py:v0.3.12"  # optional: benchmark-variants.sh; the hap.py biocontainer (0.3.15) has no RTG Tools, so it cannot run --engine=vcfeval

# --- Structural variant callers ---
MANTA_IMAGE="quay.io/biocontainers/manta:1.6.0--h9ee0642_2"  # legacy: no automated bumps
DELLY_IMAGE="quay.io/biocontainers/delly:2.7.0--h3752d28_0"  # since 2.3.0 the short-read caller is `delly sr`, not `delly call`
CNVPYTOR_IMAGE="quay.io/biocontainers/cnvpytor:1.3.2--pyhdfd78af_0"
GRIDSS_IMAGE="quay.io/biocontainers/gridss:2.13.2--h96c455f_6"  # legacy: no automated bumps
DUPHOLD_IMAGE="brentp/duphold:v0.2.3"  # legacy: no automated bumps
ANNOTSV_IMAGE="quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0"
STRANGER_IMAGE="quay.io/biocontainers/stranger:0.10.2--pyhdfd78af_0"
SURVIVOR_IMAGE="quay.io/biocontainers/survivor:1.0.7--h077b44d_7"  # step 22; legacy: no automated bumps (last release 2019)

# --- Variant annotation ---
VEP_IMAGE="ensemblorg/ensembl-vep:release_116.2"
PCGR_IMAGE="ghcr.io/sigven/pcgr:2.3.2"  # Docker Hub sigven/pcgr stops at 2.2.5; 2.3.x is on ghcr.io

# --- Pharmacogenomics ---
PHARMCAT_IMAGE="pgkb/pharmcat:3.4.0"
# hold: pypgx stays at 0.26.0 until upstream releases the pandas fix (0.28.0)
# and a bundle tag of the same version exists; 0.27.0 pulled pandas 3.0 and
# broke every gene. Move PYPGX_BUNDLE_VERSION with it.
PYPGX_IMAGE="quay.io/biocontainers/pypgx:0.26.0--pyh7e72e81_0"

# --- Specialized analysis ---
TELOMEREHUNTER_IMAGE="quay.io/biocontainers/telomerehunter:1.1.0--pyhdfd78af_0"  # run with --plotNone: the plots of this build fail (its R lacks dplyr)
HAPLOGREP3_IMAGE="quay.io/biocontainers/haplogrep3:3.2.2--hdfd78af_1"
HAPLOCHECK_IMAGE="quay.io/biocontainers/haplocheck:1.3.3--h2a3209d_2"  # step 12: mtDNA contamination; legacy: no automated bumps (last release 2022)
YLEAF_IMAGE="quay.io/biocontainers/yleaf:3.2.1--pyh1286868_0"  # optional: step 37 (opt-in); hold: the only biocontainer, upstream is 4.x
T1K_IMAGE="quay.io/biocontainers/t1k:1.0.10--h5814d7d_0"
EXPANSIONHUNTER_IMAGE="quay.io/biocontainers/expansionhunter:5.0.0--hc26b3af_5"
GOLEFT_IMAGE="quay.io/biocontainers/goleft:0.2.6--he881be0_1"
MOSDEPTH_IMAGE="quay.io/biocontainers/mosdepth:0.3.14--h87be163_2"
PARASCOPY_IMAGE="quay.io/biocontainers/parascopy:1.19.0--py311h98bf483_0"  # optional: step 35 (opt-in, SMN1/SMN2 copy number)

# --- Sample identity and contamination (step 33) ---
SOMALIER_IMAGE="quay.io/biocontainers/somalier:0.3.5--h5205c93_0"
VERIFYBAMID2_IMAGE="quay.io/biocontainers/verifybamid2:2.0.3--hc004090_0"

# --- General purpose ---
GATK_IMAGE="broadinstitute/gatk:4.7.0.0"
PICARD_IMAGE="broadinstitute/picard:3.5.0"
PYTHON_IMAGE="python:3.14.8@sha256:1eb6b7d4b76454b1de8317863ac3213b678c337b27e604a4e3fb70bddbb2bad7"  # patch tag pinned to its digest: the publisher rebuilds 3.14.8 in place
# hold: plink2 stays at 2.00a5.10, the only versioned tag its publisher ships
# and the build pgsc_calc uses.
PLINK2_IMAGE="pgscatalog/plink2:2.00a5.10"

# --- Polygenic scores and ancestry (steps 25 and 26) ---
# pgsc_calc, the PGS Catalog's own Nextflow pipeline, runs as a pipeline of
# its own (step 25 and the PRS process start it). The images below are the
# ones its conf/modules.config names at PGSC_CALC_VERSION; step 25 hands them
# to it, with PLINK2_IMAGE for its plink2 steps, so a bump of
# PGSC_CALC_VERSION means reading that file again and moving these with it.
# hold: each of these moves only with PGSC_CALC_VERSION (renovate.json
# leaves ghcr.io/pgscatalog/ alone).
PGSC_UTILS_IMAGE="ghcr.io/pgscatalog/pygscatalog:pgscatalog-utils-2.0.4"
PGSC_FRAPOSA_IMAGE="ghcr.io/pgscatalog/fraposa_pgsc:v1.0.2"
PGSC_PYYAML_IMAGE="ghcr.io/pgscatalog/pyyaml:6.0"
# hold: the publisher ships these two only as the 2-beta tag, so the tag is pinned to its digest.
PGSC_ZSTD_IMAGE="ghcr.io/pgscatalog/zstd:2-beta@sha256:dea95df4f1bdee59190e5e4b88112d7f7b461463550c47d4e1c1f2526b6bd442"
PGSC_REPORT_IMAGE="ghcr.io/pgscatalog/report:2-beta@sha256:6d1ba573648346a0ae3f24418a898d202a8c581d5d190f83baa8d0db13ee02be"
MULTIQC_IMAGE="quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2"

# --- Annotation enrichment ---
VCFANNO_IMAGE="quay.io/biocontainers/vcfanno:0.3.9--h1079eea_0"
SLIVAR_IMAGE="quay.io/biocontainers/slivar:0.3.4--hb56abc1_0"

# --- Data versions coupled to an image (change them together) ---
# VEP cache release for step 13: must equal the major of VEP_IMAGE.
VEP_CACHE_RELEASE="116"
# CPSR (step 17): PCGR_IMAGE 2.3.2 runs VEP 115 internally and reads this
# reference bundle (pcgr/pcgr_vars.py: VEP_VERSION, DB_VERSION); both move
# with PCGR_IMAGE.
PCGR_VEP_CACHE_RELEASE="115"
PCGR_DATA_BUNDLE="20260620"
# pypgx-bundle git tag (step 32): must equal the version of PYPGX_IMAGE.
PYPGX_BUNDLE_VERSION="0.26.0"
# Cyrius (step 21, opt-in; legacy: no automated bumps) is installed by
# `setup.sh --cyrius` from scripts/cyrius-constraints.txt, every wheel pinned
# by its sha256. Change the two together.
CYRIUS_VERSION="1.1.1"
# Parascopy's precomputed GRCh38 homology table and population models (step
# 35, `setup.sh --parascopy-data`), Zenodo record 15019940; read by
# PARASCOPY_IMAGE 1.19.0.
PARASCOPY_DATA_VERSION="1.7"
# IPD-KIR release T1K types KIR against (step 08 with KIR=true, `setup.sh
# --kir-data`); the IPD-IMGT/HLA release is HLA_DB_RELEASE in scripts/lib/common.sh.
KIR_DB_RELEASE="2.15.0"
# AnnotSV annotation data (setup.sh): the release of ANNOTSV_IMAGE.
ANNOTSV_ANNOTATIONS_VERSION="3.5"
# Commit of the GRIDSS repository the ENCODE blacklist is taken from (step 04b).
GRIDSS_BLACKLIST_COMMIT="bd7daff8fc32f349752ff713e1fd776361a57d7e"
# hold: the gnomAD constraint table (annotations/gnomad_v4.1_constraint.tsv,
# steps 23 and 31) stays on v4.1 until the layout of the 4.1.2 file, about six
# times larger, has been read and the two steps adapted.
# Nextflow release the pipeline is validated with.
NEXTFLOW_VERSION="25.10.8"
# Release of pgsc_calc (github.com/PGScatalog/pgsc_calc) steps 25 and 26 run;
# the PGSC_*_IMAGE lines above belong to it. setup.sh pulls it with Nextflow.
PGSC_CALC_VERSION="v2.3.0"
# sha256 of GitHub's archive of that tag, which setup.sh and step 25 unpack.
PGSC_CALC_SHA256="f7685b30177f0f37bbe8d3baee885563ce935b271ff75be3e15215fea28d81f4"
# The nf-schema plugin release pgsc_calc's nextflow.config names at
# PGSC_CALC_VERSION; setup.sh installs it so pgsc_calc runs offline.
PGSC_CALC_NF_SCHEMA="2.0.0"
# Yleaf's marker tables and haplogroup tree (step 37, `setup.sh --yleaf-data`):
# the yleaf/data folder of GitHub's archive of this tag, which YLEAF_IMAGE (the
# same release) does not ship. Change the three together.
YLEAF_DATA_VERSION="3.2.1"
YLEAF_DATA_SHA256="dc288e97c351a3e62093195d27a5fdda0c4ea9e176d66b0adf91eb9bbbf4dfd3"
# pgsc_calc's ancestry reference panel (setup.sh --ancestry-panel): the 1000
# Genomes database the PGS Catalog publishes for this pgsc_calc release line.
PGSC_PANEL="pgsc_1000G_v1"
