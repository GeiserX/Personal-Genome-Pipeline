# shellcheck shell=bash
# versions.env: every container image and every coupled data version the
# pipeline uses. Scripts read it through scripts/lib/common.sh; no script names
# an image or a data release itself, so a version bump is one line here.
#
# To bump a tool: change its line, then run ./scripts/setup.sh --pull-only.
# Lines marked `# optional` (alternative callers and aligners, the benchmark)
# are not pre-pulled by setup.sh nor checked by validate-setup.sh; docker pulls
# them the first time a step runs them. Keep every line NAME="value": several
# CI checks and Renovate read this file as text.
#
# Images whose publisher offers no versioned tags are pinned by digest
# (name@sha256:...) instead of a floating :latest. To refresh one:
#   docker manifest inspect -v <name>:latest | grep -m1 digest
#
# Holds and legacy tools are noted next to their pins. "legacy: no automated
# bumps" means the upstream is archived or quiet; bump it by hand after a test.

# --- Core tools ---
MINIMAP2_IMAGE="quay.io/biocontainers/minimap2:2.31--h118bc1c_0"
SAMTOOLS_IMAGE="staphb/samtools:1.24"
# hold: the Nextflow task ALIGN_MINIMAP2 pipes minimap2 into samtools in one
# container, so it needs one image with both. BioContainers builds it from a
# line of BioContainers/multi-package-containers combinations/hash.tsv; the
# tag is a hash, so Renovate cannot bump it. It moves by hand with
# MINIMAP2_IMAGE and SAMTOOLS_IMAGE: request the new pair there, then pin the
# new tag and its versions in the comment below. scripts/ci/check-images.sh
# fails while the comment and those two tags disagree, and the container test
# runs both tools' version commands in the image.
MINIMAP2_SAMTOOLS_IMAGE="quay.io/biocontainers/mulled-v2-66534bcbb7031a148b13e2ad42583020b9cd25c4:ad4c240457048f1d3cc0bd8c8fa39bf27d222eb7-0"  # hold: minimap2=2.31,samtools=1.24, the releases of MINIMAP2_IMAGE and SAMTOOLS_IMAGE; Nextflow alignment only
SAMTOOLS_HTTPS_IMAGE="quay.io/biocontainers/samtools:1.25--h9dcdb79_0"  # optional: docs/quick-test.md reads a CRAM over https with it; SAMTOOLS_IMAGE has no CA certificates
BCFTOOLS_IMAGE="staphb/bcftools:1.24"
DEEPVARIANT_IMAGE="google/deepvariant:1.10.0"
FASTP_IMAGE="quay.io/biocontainers/fastp:1.4.0--h43da1c4_0"

# --- Alternative aligners and callers (optional) ---
BWAMEM2_IMAGE="quay.io/biocontainers/bwa-mem2:2.3--he70b90d_0"  # optional: step 02a; 2.3 reads a 2.2.1 index (no index code changed between the two)
BWA_IMAGE="quay.io/biocontainers/bwa:0.7.19--h577a1d6_1"  # optional: classic BWA index for GRIDSS (step 04b)
FREEBAYES_IMAGE="quay.io/biocontainers/freebayes:1.3.10--h3752d28_1"  # optional: step 03b
STRELKA_IMAGE="quay.io/biocontainers/strelka:2.9.10--h9ee0642_1"  # optional: step 03c; legacy: no automated bumps
OCTOPUS_IMAGE="dancooke/octopus:0.7.4"  # optional: step 03d; legacy: no automated bumps
CLAIR3_IMAGE="hkubal/clair3:v2.0.5"  # optional: step 03e
TIDDIT_IMAGE="quay.io/biocontainers/tiddit:3.9.7--py312hfcd9dac_0"  # optional: step 04a
SNIFFLES_IMAGE="quay.io/biocontainers/sniffles:2.8.0--pyhdfd78af_1"  # optional: step 04c; hold: 2.8.1 waits for bioconda
HAPPY_IMAGE="jmcdani20/hap.py:v0.3.12"  # optional: benchmark-variants.sh; the hap.py biocontainer (0.3.15) has no RTG Tools, so it cannot run --engine=vcfeval

# --- Structural variant callers ---
MANTA_IMAGE="quay.io/biocontainers/manta:1.6.0--h9ee0642_2"  # legacy: no automated bumps
DELLY_IMAGE="quay.io/biocontainers/delly:2.7.0--h3752d28_0"  # since 2.3.0 the short-read caller is `delly sr`, not `delly call`
CNVPYTOR_IMAGE="quay.io/biocontainers/cnvpytor:1.3.2--pyhdfd78af_0"
GRIDSS_IMAGE="quay.io/biocontainers/gridss:2.13.2--h96c455f_6"  # legacy: no automated bumps
DUPHOLD_IMAGE="brentp/duphold:v0.2.3"  # legacy: no automated bumps
ANNOTSV_IMAGE="quay.io/biocontainers/annotsv:3.5.10--hdfd78af_0"
STRANGER_IMAGE="quay.io/biocontainers/stranger:0.10.2--pyhdfd78af_0"
SURVIVOR_IMAGE="quay.io/biocontainers/survivor:1.0.7--h077b44d_7"  # step 22; legacy: no automated bumps (last release 2019)

# --- Variant annotation ---
VEP_IMAGE="ensemblorg/ensembl-vep:release_116.3"
PCGR_IMAGE="ghcr.io/sigven/pcgr:2.3.2"  # Docker Hub sigven/pcgr stops at 2.2.5; 2.3.x is on ghcr.io

# --- Pharmacogenomics ---
PHARMCAT_IMAGE="pgkb/pharmcat:3.4.0"
# hold: pypgx stays at 0.26.0 until upstream releases the pandas fix (0.28.0)
# and a bundle tag of the same version exists; 0.27.0 pulled pandas 3.0 and
# broke every gene. Move PYPGX_BUNDLE_VERSION with it.
PYPGX_IMAGE="quay.io/biocontainers/pypgx:0.26.0--pyh7e72e81_0"

# --- Specialized analysis ---
TELOMEREHUNTER_IMAGE="quay.io/biocontainers/telomerehunter:1.1.0--pyhdfd78af_0"  # run with --plotNone: the plots of this build fail (its R lacks dplyr)
HAPLOGREP3_IMAGE="quay.io/biocontainers/haplogrep3:3.2.2--hdfd78af_1"
HAPLOCHECK_IMAGE="quay.io/biocontainers/haplocheck:1.3.3--h2a3209d_2"  # step 12: mtDNA contamination; legacy: no automated bumps (last release 2022)
EKLIPSE_IMAGE="quay.io/biocontainers/eklipse:1.8--hdfd78af_6@sha256:edd58aa92dcd62a39328d20b044fc024978afce31f70ba5cd174279f85146705"  # step 20: large mtDNA deletions; upstream has no release: the Bioconda recipe builds commit 3606cb2edac983d2623ddc667b49206c3d01373c (2022-02-03), AGPL-3.0, run as its own tool; legacy: no automated bumps (eKLIPse is no longer maintained)
YLEAF_IMAGE="quay.io/biocontainers/yleaf:3.2.1--pyh1286868_0"  # optional: step 37 (opt-in); hold: the only biocontainer, upstream is 4.x
HIPSTR_IMAGE="quay.io/biocontainers/hipstr:0.7--hcf09f9e_1"  # optional: step 45 (opt-in, Y-STR repeat counts of male samples)
T1K_IMAGE="quay.io/biocontainers/t1k:1.0.10--h5814d7d_0"
OPTITYPE_IMAGE="quay.io/biocontainers/optitype:1.5.0--pyhdfd78af_1"  # optional: step 08 with HLA_QC=true (opt-in second HLA caller, class I)
EXPANSIONHUNTER_IMAGE="quay.io/biocontainers/expansionhunter:5.0.0--hc26b3af_5"
GOLEFT_IMAGE="quay.io/biocontainers/goleft:0.2.6--he881be0_1"
MOSDEPTH_IMAGE="quay.io/biocontainers/mosdepth:0.3.14--h87be163_2"
PARASCOPY_IMAGE="quay.io/biocontainers/parascopy:1.19.0--py311h98bf483_0"  # optional: step 35 (opt-in, SMN1/SMN2 copy number)
PARAPHASE_IMAGE="quay.io/biocontainers/paraphase:4.1.0--h9ee0642_0"  # optional: step 35b (opt-in, PacBio HiFi BAMs only: its licence allows PacBio data only)
# MEGAnE's only image (amd64 only, about 6.4 GB), its last release (2022, a beta), pinned to its
# digest. Its call_genotype_38 brings its own GRCh38 RepeatMasker and BLAST files; the k-mer set
# step 50 needs is built from the reference by setup.sh --megane-kmers.
MEGANE_IMAGE="shoheikojima/megane:v1.0.1.beta@sha256:f7d38cc1a4f41797d84214e326336bbbeebd3f20ffca8416308ecc48143c6b10"  # optional: step 50 (opt-in, Alu, L1 and SVA insertions)
VNTYPER_IMAGE="ghcr.io/hassansaei/vntyper:2.0.47"  # optional: step 52 (opt-in, MUC1 VNTR frameshifts); the publisher's image, reference data inside, about 3 GB (Docker Hub's saei/vntyper stops at 2.0.3)

# --- Sample identity and contamination (step 33) ---
SOMALIER_IMAGE="quay.io/biocontainers/somalier:0.3.6--h5205c93_0"
VERIFYBAMID2_IMAGE="quay.io/biocontainers/verifybamid2:2.0.3--hc004090_0"

# --- Family analysis (step 38, opt-in: a pedigree of two or more samples) ---
GLNEXUS_IMAGE="quay.io/biocontainers/glnexus:1.4.1--h17e8430_5"  # optional: step 38, the joint call of the members' gVCFs
WHATSHAP_IMAGE="quay.io/biocontainers/whatshap:2.8--py312hf731ba3_0"  # step 42, read-backed phasing of the genotype rules that need it; step 38, phasing by inheritance (whatshap phase --ped)
# hold: hap-ibd's tag carries the release date (1.0.rev20May22.818), which
# Renovate's biocontainers versioning cannot read, so renovate.json disables
# it: check https://github.com/browning-lab/hap-ibd by hand. Apache-2.0.
HAP_IBD_IMAGE="quay.io/biocontainers/hap-ibd:1.0.rev20May22.818--hdfd78af_0"  # optional: step 38, shared segments between members (with BEAGLE_IMAGE and step 26b's panel)

# --- Symptom-driven ranking (step 48, opt-in: HPO terms) ---
# The -bash build: the plain tag is distroless, with no shell for Nextflow's task script.
EXOMISER_IMAGE="exomiser/exomiser-cli:15.1.0-bash"  # optional: step 48 (opt-in, runs with HPO terms)

# --- General purpose ---
GATK_IMAGE="broadinstitute/gatk:4.7.0.0"
PICARD_IMAGE="broadinstitute/picard:3.5.0"
PYTHON_IMAGE="python:3.15.2@sha256:d7a732b20de2f5d3cf977cbcf69aacf30dc928a37908ff9fdb7bb3503024c91a"  # patch tag pinned to its digest: the publisher rebuilds a patch tag in place
# hold: plink2 stays at 2.00a5.10, the only versioned tag its publisher ships
# and the build pgsc_calc uses.
PLINK2_IMAGE="pgscatalog/plink2:2.00a5.10"

# --- Polygenic scores and ancestry (steps 25 and 26) ---
# pgsc_calc, the PGS Catalog's own Nextflow pipeline, runs as a pipeline of
# its own (step 25 and the PRS process start it). The images below are the
# ones its conf/modules.config names at PGSC_CALC_VERSION; step 25 hands them
# to it, with PLINK2_IMAGE for its plink2 steps, so a bump of
# PGSC_CALC_VERSION means reading that file again and moving these with it.
# hold: each of these moves only with PGSC_CALC_VERSION (renovate.json
# leaves ghcr.io/pgscatalog/ alone).
PGSC_UTILS_IMAGE="ghcr.io/pgscatalog/pygscatalog:pgscatalog-utils-2.0.4"
PGSC_FRAPOSA_IMAGE="ghcr.io/pgscatalog/fraposa_pgsc:v1.0.2"
PGSC_PYYAML_IMAGE="ghcr.io/pgscatalog/pyyaml:6.0"
# hold: the publisher ships these two only as the 2-beta tag, so the tag is pinned to its digest.
PGSC_ZSTD_IMAGE="ghcr.io/pgscatalog/zstd:2-beta@sha256:dea95df4f1bdee59190e5e4b88112d7f7b461463550c47d4e1c1f2526b6bd442"
PGSC_REPORT_IMAGE="ghcr.io/pgscatalog/report:2-beta@sha256:6d1ba573648346a0ae3f24418a898d202a8c581d5d190f83baa8d0db13ee02be"
MULTIQC_IMAGE="quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2"

# --- Fine-grained ancestry (step 26b, opt-in) ---
# ADMIXTURE is free for academic use; RFMix for academic research use only,
# and any other use, a personal one included, needs a licence from Stanford.
# None of the three tags is a version Renovate's biocontainers versioning can
# read, so renovate.json disables all three; bump one by hand after running
# step 26b on the fixture.
ADMIXTURE_IMAGE="quay.io/biocontainers/admixture:1.3.0--0"  # optional: step 26b; legacy: no automated bumps (1.3.0 is the only BioContainers build)
# hold: Beagle's tag carries the release date (5.5_27Feb25.75f), which neither
# Renovate nor scripts/ci/freshness.py can order, so neither reports a newer
# one: check https://faculty.washington.edu/browning/beagle/beagle.html by hand.
BEAGLE_IMAGE="quay.io/biocontainers/beagle:5.5_27Feb25.75f--hdfd78af_0"  # optional: steps 26b and 51 phasing
RFMIX_IMAGE="quay.io/biocontainers/rfmix:2.03.r0.9505bfa--h503566f_8"  # optional: step 26b painting; legacy: no automated bumps (last release 2017)
BCFTOOLS_HTTPS_IMAGE="quay.io/biocontainers/bcftools:1.25--h118bc1c_1"  # optional: setup.sh --ancestry-fine-panel reads the panel over https; BCFTOOLS_IMAGE has no CA certificates

# --- Mosaic chromosomal alterations (step 51, opt-in) ---
# MoChA (github.com/freeseek/mocha, MIT licence) has no tagged release. Its
# authors publish bcftools 1.22 with the plugin as this image (tag
# 1.22-20250819, pushed 2025-08-20), pinned by digest. MOCHA_VERSION is the
# version the plugin prints, the MOCHA_VERSION define of mocha.c at
# MOCHA_COMMIT (2025-08-22; the commit after the build changed README.md only).
# tests/e2e/mocha-1.sh checks the image prints MOCHA_VERSION and mocha.c at
# MOCHA_COMMIT defines it; tests/test_mocha_report.py checks the digest and the
# commit. Move the three together, by hand.
MOCHA_IMAGE="us.gcr.io/mccarroll-mocha/bcftools:1.22-20250819@sha256:c9398385cfe3a968918ddf470e2769b7ee42cbc0bb8f564b4744c460343550a5"  # optional: step 51; hold: tag and digest move with MOCHA_COMMIT
MOCHA_COMMIT="95686b7b65f53a490513be76bb120e5fc20a8bcf"
MOCHA_VERSION="2025-08-19"

# --- Archaic ancestry (step 43, opt-in) ---
IBDMIX_IMAGE="quay.io/biocontainers/ibdmix:1.0.1--h4ac6f70_2"  # optional: step 43; legacy: no automated bumps (1.0.1, 2022, is the last release)
# --- Ancient populations (step 44, opt-in) ---
# EIGENSOFT's smartpca and convertf. 9.0.0 is the first release that reads the
# AADR's transposed packed genotypes (TGENO, src/mcio.c); 8.0.0 does not.
EIGENSOFT_IMAGE="quay.io/biocontainers/eigensoft:9.0.0--h519d32d_0"  # optional: step 44

# --- Annotation enrichment ---
VCFANNO_IMAGE="quay.io/biocontainers/vcfanno:0.3.9--h1079eea_0"
SLIVAR_IMAGE="quay.io/biocontainers/slivar:0.3.4--hb56abc1_0"

# --- Data versions coupled to an image (change them together) ---
# VEP cache release for step 13: must equal the major of VEP_IMAGE.
VEP_CACHE_RELEASE="116"
# CPSR (step 17): PCGR_IMAGE 2.3.2 runs VEP 115 internally and reads this
# reference bundle (pcgr/pcgr_vars.py: VEP_VERSION, DB_VERSION); both move
# with PCGR_IMAGE.
PCGR_VEP_CACHE_RELEASE="115"
PCGR_DATA_BUNDLE="20260620"
# pypgx-bundle git tag (step 32): must equal the version of PYPGX_IMAGE.
PYPGX_BUNDLE_VERSION="0.26.0"
# Cyrius (step 21, opt-in; legacy: no automated bumps) is installed by
# `setup.sh --cyrius` from scripts/cyrius-constraints.txt, every wheel pinned
# by its sha256. Change the two together.
CYRIUS_VERSION="1.1.1"
# Parascopy's precomputed GRCh38 homology table and population models (step
# 35, `setup.sh --parascopy-data`), Zenodo record 15019940; read by
# PARASCOPY_IMAGE 1.19.0.
PARASCOPY_DATA_VERSION="1.7"
# IPD-KIR release T1K types KIR against (step 08 with KIR=true, `setup.sh
# --kir-data`); the IPD-IMGT/HLA release is HLA_DB_RELEASE in scripts/lib/common.sh.
KIR_DB_RELEASE="2.15.0"
# AnnotSV annotation data (setup.sh): the release of ANNOTSV_IMAGE.
ANNOTSV_ANNOTATIONS_VERSION="3.5"
# Two files setup.sh adds to AnnotSV's data (step 5): gnomAD-SV's sites, whose
# common SVs join AnnotSV's benign set, and NCBI's MANE summary, whose MANE
# Select RefSeq transcripts step 05 passes as -txFile. Each sha256 is of the
# file as downloaded; change a version and its sha256 together.
GNOMAD_SV_VERSION="4.1"
GNOMAD_SV_SHA256="26a70c309a853c77c043c8d710016f97a326d4a55cc89a08bc45384e00de2b04"
MANE_RELEASE="1.5"
MANE_SUMMARY_SHA256="d10ace2720681a3b2e0eefd9da4f551274a6b4141ac9bfd6a2565dfb6e9ad55c"
# gnomAD v3.1's mitochondrial sites (step 20 annotates the chrM calls with
# their AF_hom, AF_het and max_hl): setup.sh stores the file under
# gnomad_mito/ by its name in the URL and checks it against the sha256 of the
# file as downloaded. Change the two together.
GNOMAD_MITO_URL="https://storage.googleapis.com/gcp-public-data--gnomad/release/3.1/vcf/genomes/gnomad.genomes.v3.1.sites.chrM.vcf.bgz"
GNOMAD_MITO_SHA256="507e4a1fab8c8d2dfb5d77239b0fb31e3db92634519f1d6cd9b9ff38df181f99"
# STRchive (github.com/dashnowlab/STRchive, CC BY 4.0), the disease repeat
# catalog steps 09 and 9b run on: setup.sh downloads its ExpansionHunter
# catalog and its loci file from the release, checks each against its sha256
# (of the file as downloaded) and joins them with bin/strchive_convert.py
# into reference/strchive-<version>/catalog.json. Change the three together.
STRCHIVE_VERSION="v2.28.0"
STRCHIVE_EH_SHA256="e87177dcae3e09acaa3fe766818e16d334b1f206f29f714bcf6b42fd2f5a5c9a"
STRCHIVE_LOCI_SHA256="16301ecb00239f0e3c684913aefc2f48c6f5a7c2a481958aab4db55d282bca86"
# Commit of the GRIDSS repository the ENCODE blacklist is taken from (step 04b).
GRIDSS_BLACKLIST_COMMIT="bd7daff8fc32f349752ff713e1fd776361a57d7e"
# hold: the gnomAD constraint table (annotations/gnomad_v4.1_constraint.tsv,
# steps 23 and 31) stays on v4.1 until the layout of the 4.1.2 file, about six
# times larger, has been read and the two steps adapted.
# Nextflow release the pipeline is validated with.
NEXTFLOW_VERSION="26.10.5"
# Release of pgsc_calc (github.com/PGScatalog/pgsc_calc) steps 25 and 26 run;
# the PGSC_*_IMAGE lines above belong to it. setup.sh pulls it with Nextflow.
PGSC_CALC_VERSION="v2.3.0"
# sha256 of GitHub's archive of that tag, which setup.sh and step 25 unpack.
PGSC_CALC_SHA256="f7685b30177f0f37bbe8d3baee885563ce935b271ff75be3e15215fea28d81f4"
# The nf-schema plugin release pgsc_calc's nextflow.config names at
# PGSC_CALC_VERSION; setup.sh installs it so pgsc_calc runs offline.
PGSC_CALC_NF_SCHEMA="2.0.0"
# Yleaf's marker tables and haplogroup tree (step 37, `setup.sh --yleaf-data`):
# the yleaf/data folder of GitHub's archive of this tag, which YLEAF_IMAGE (the
# same release) does not ship. Change the three together.
YLEAF_DATA_VERSION="3.2.1"
YLEAF_DATA_SHA256="dc288e97c351a3e62093195d27a5fdda0c4ea9e176d66b0adf91eb9bbbf4dfd3"
# The current Y tree step 37 places the sample on beside Yleaf's own (setup.sh
# --yleaf-data installs it into <yleaf data>/ytree): YFull's YTree release
# YTREE_VERSION (CC BY 4.0) at its commit in github.com/YFullTeam/YTree, and
# the GRCh38 SNP tables of Yleaf YTREE_POSITIONS_VERSION (GPL-3.0) at the
# commit of that tag, which give each tree SNP its position and bases.
YTREE_VERSION="14.06.0"
YTREE_COMMIT="bdc9bb4d8db72abc7658362f258dbc2a63e34789"
YTREE_SHA256="98c6d8e0642533c01070142edad2a693c30ed86f972b1deb519218209a91df6d"
YTREE_POSITIONS_VERSION="4.1.6"
YTREE_POSITIONS_COMMIT="c167c4e8951623a53c370e7c300a0cfc7f411b62"
YTREE_FTDNA_SHA256="69632f8ee9baa3c8bed4ecd956ee6f33035f9df1949ae871154904d71ad651ec"
YTREE_YFULL_SHA256="c249a86420fb115e12348253d7bdaed061887eb5c093ab3795a1569d74c0df90"
# Ensembl's GRCh38 gene annotation (step 49, `setup.sh --chip-data`):
# Homo_sapiens.GRCh38.<release>.chr.gff3.gz, from which step 49 takes each CHIP
# gene's MANE Select transcript, checked against the sha256 of the file as
# downloaded. Change the two together, and read assets/chip_genes.tsv's codons
# and exons against the new transcripts.
ENSEMBL_GFF_RELEASE="116"
ENSEMBL_GFF_SHA256="0857407b4a8be8792089a69fd961737256fb7129b6b799f8a8920ebea4fb134f"
# pgsc_calc's ancestry reference panel (setup.sh --ancestry-panel): the 1000
# Genomes database the PGS Catalog publishes for this pgsc_calc release line.
PGSC_PANEL="pgsc_1000G_v1"
# The reference panel of step 26b (setup.sh --ancestry-fine-panel): gnomAD's
# HGDP + 1000 Genomes callset phased with SHAPEIT5, resources/hgdp_1kg/
# phased_haplotypes_v2 of gnomAD's public bucket. The sha256 of the crc32c and
# size of its 22 chromosome files (setup.sh's ancestry_fine_pins), of its
# sample metadata (release/3.1/secondary_analyses/hgdp_1kg_v2) and of Beagle's
# GRCh38 genetic map. Change them together, after reading what changed.
ANCESTRY_FINE_PANEL="hgdp1kgp_v2"
ANCESTRY_FINE_PANEL_SHA256="2188969c400b0c8291266962e989f7fe41a375a7802fee5aa0559e463b37a8a9"
ANCESTRY_FINE_META_SHA256="e18e7a29d0567b8063edc1a714bd31e57dc422823ba51af2c63fecef0dbc3cf1"
ANCESTRY_FINE_MAP_SHA256="521549889b9ce0236142a4fb7db45d3f00035ec645e01465490d55f5b8ef26d6"

# The consumer raw-data export (step 40, opt-in; `setup.sh --consumer-sites`
# builds its site table). The 23andMe v5 chip's site list, with GRCh37
# positions and reference bases, from this commit of
# github.com/arrogantrobot/23andme2vcf (MIT licence), checked against the
# sha256; and dbSNP's GRCh38 VCF of this build, checked against the md5 NCBI
# publishes, which gives each rsID its GRCh38 position. A new build changes
# the table's name, so step 40 runs on the new one. Change the build and its
# md5 together.
CONSUMER_SITES_COMMIT="e2af7b2eb45f8f8a9644bbbd824f9d097aed0c11"
CONSUMER_SITES_SHA256="c37b86205f8fed884cbbd201c33a6d5dccfa66b7a8a450e5355f5be49fcf88f0"
CONSUMER_DBSNP_BUILD="b157"
CONSUMER_DBSNP_MD5="6a6f313e92a39c337571174dad12cfe1"
# The sha256 of the site table those two inputs give (its content, read
# through gzip), from one full build. setup.sh and validate-setup.sh warn when
# a built table differs. Take it again when the build, the commit or
# bin/export_consumer.py build-sites changes: `gzip -dc <table> | sha256sum`.
CONSUMER_SITES_TABLE_SHA256="d6a32e038167fb8596fe392ea69a4282e8d33bb1dd9b4f1beb27fe0852dce3e1"
# The archaic data of step 43 (setup.sh --archaic): the snpAD genotypes of
# the Altai and Vindija 33.19 Neanderthals and the Altai Denisovan (MPI-EVA,
# cdna.eva.mpg.de/neandertal/Vindija/VCF/<genome>/, GRCh37), each file checked
# against the md5 its folder's md5sums.txt lists, whose sha256 is pinned here;
# the 1000 Genomes phase 3 sites file (GRCh37), checked against the md5 the
# project lists in its current.tree; and UCSC's hg19ToHg38 chain. setup.sh
# builds reference/archaic/ARCHAIC_DATA_VERSION from them. Change a pin only
# after reading what changed upstream, and ARCHAIC_DATA_VERSION with it.
ARCHAIC_DATA_VERSION="snpad2016-1kgp3-v2"
