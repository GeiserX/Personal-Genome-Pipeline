/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Personal Genome Pipeline — Nextflow Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // ── Input/output ────────────────────────────────────────────────────
    input              = null       // Path to samplesheet CSV: one row per sample, from FASTQ, BAM or VCF
    outdir             = './results'
    publish_dir_mode   = 'copy'
    allow_unfiltered   = false      // accept a VCF with no FILTER=PASS record, treating FILTER '.' as PASS

    // ── Reads to VCF (FASTQ and BAM-only rows) ──────────────────────────
    skip_trim          = false      // align the raw reads, without fastp (scripts/01b's SKIP_TRIM=true)
    minimap2_index     = null       // minimap2 sr index; default <reference base>.sr.mmi beside the FASTA, else built
    intervals          = null       // DeepVariant --regions, space-separated (scripts/03's INTERVALS); null = whole genome
    sex_check          = 'fail'     // when indexcov's (or, with sample_qc, somalier's) sex disagrees with the samplesheet: fail, or warn and go on

    // ── Reference data ──────────────────────────────────────────────────
    reference          = null       // GRCh38 reference FASTA (required)
    clinvar            = null       // ClinVar pathogenic VCF (optional)
    clinvar_index      = null       // ClinVar pathogenic VCF tabix index

    // ── Tool selection ──────────────────────────────────────────────────
    // Comma-separated list of analysis tools to run.
    // Default set works without any external databases. prs and vcfanno are
    // in it but are skipped, with a warning, until --pgs_scoring or a score
    // file is set. Tools that require large downloads are opt-in — add them
    // to --tools once you have the databases in place:
    //   vep,slivar,clinical_filter  (need --vep_cache)
    //   cpsr                        (need --pcgr_data + --vep_cache_cpsr)
    //   expansion_hunter            (need --expansion_catalog)
    //   clinvar                     (need --clinvar + --clinvar_index)
    //   hla_typing                  (need --hla_dat + --hla_genes)
    //   annotsv                     (need --annotsv_annotations)
    //   cnvpytor                    (need --cnvpytor_resources)
    //   sample_qc                   (need --somalier_sites + --verifybamid2_panel)
    //   cyrius                      (need --cyrius_install: setup.sh --cyrius; non-commercial licence)
    //   parascopy                   (need --parascopy_data: setup.sh --parascopy-data)
    //   y_haplogroup                (need --yleaf_data: setup.sh --yleaf-data; male samples only)
    // SV callers and other extras are also opt-in:
    //   manta,delly,cnvpytor,duphold,annotsv,survivor_merge,pypgx,cram_archive
    //   ancestry                    (need --ancestry_ref; computed by pgsc_calc inside prs)
    tools = 'pharmcat,cpic,vcfanno,roh,prs,mito_haplogroup,telomere_hunter,mosdepth,mito_variants,html_report,multiqc'

    // ── Annotation databases (optional — modules skip if not provided) ─
    vep_cache          = null       // VEP offline cache directory (release 116)
    vep_cache_cpsr     = null       // VEP cache for CPSR (PCGR_VEP_CACHE_RELEASE in versions.env, 115; separate)
    pcgr_data          = null       // PCGR/CPSR reference data bundle directory
    pypgx_bundle       = null       // pypgx-bundle reference directory
    cnvpytor_resources = null       // dir with pinned CNVpytor gc_*/mask_* .pytor files (see docs/00-reference-setup.md)
    delly_exclude      = null       // Delly exclude map passed as `delly sr -x` (optional, e.g. human.hg38.excl.tsv)
    manta_call_regions = null       // bgzipped BED (.tbi beside it) passed as configManta.py --callRegions (optional)
    cytoband           = null       // UCSC GRCh38 chromosome bands passed as telomerehunter -b (optional, cytoBand.hg38.txt)
    annotsv_annotations = null      // AnnotSV annotation dir (holds Annotations_Human/), built once with INSTALL_annotations.sh
    somalier_sites     = null       // somalier's GRCh38 sites VCF (sample_qc; setup.sh installs reference/somalier/sites.hg38.vcf.gz)
    verifybamid2_panel = null       // folder of VerifyBamID2's .UD/.mu/.bed panel (sample_qc; setup.sh installs reference/verifybamid2/)
    freemix_warn       = 0.03       // sample_qc: FREEMIX above this is reported as possible contamination (never stops the run)

    // CADD whole-genome pre-scored files
    cadd_snv           = null       // CADD SNV scores (tsv.gz)
    cadd_snv_index     = null       // CADD SNV tabix index
    cadd_indel         = null       // CADD indel scores (tsv.gz)
    cadd_indel_index   = null       // CADD indel tabix index

    // SpliceAI pre-scored files
    spliceai_snv       = null       // SpliceAI SNV VCF (vcf.gz)
    spliceai_snv_index = null       // SpliceAI SNV tabix index
    spliceai_indel     = null       // SpliceAI indel VCF (vcf.gz)
    spliceai_indel_index = null     // SpliceAI indel tabix index

    // Other annotation scores
    revel              = null       // REVEL pathogenicity scores file
    revel_index        = null       // REVEL tabix index
    alphamissense      = null       // AlphaMissense scores file
    alphamissense_index = null      // AlphaMissense tabix index
    gnomad_constraint  = null       // gnomAD gene constraint TSV (LOEUF, pLI)

    // ── Clinical & population genetics ──────────────────────────────────
    pgs_scoring        = null       // folder of GRCh38-harmonised PGS Catalog scoring files (setup.sh fills <genome_dir>/prs_scores)
    ancestry_ref       = null       // pgsc_calc's ancestry panel, <genome_dir>/reference/pgsc_calc/pgsc_1000G_v1.tar.zst (setup.sh --ancestry-panel): percentiles and step 26
    pgsc_calc          = null       // pgsc_calc checkout setup.sh makes (<genome_dir>/tools/pgsc_calc-<release>): prs then runs offline
    expansion_catalog  = null       // ExpansionHunter variant catalog JSON
    hla_dat            = null       // Pre-downloaded IPD-IMGT/HLA hla.dat file
    hla_genes          = null       // gene lines of GENCODE's basic GTF: T1K's GRCh38 gene coordinates (setup.sh installs it)
    kir                = false      // hla_typing: also type the KIR genes (a second T1K pass; needs --kir_dat)
    kir_dat            = null       // IPD-KIR's kir.dat, release KIR_DB_RELEASE (setup.sh --kir-data installs kir/IPD-KIR_<release>/kir.dat)
    cyrius_install     = null       // cyrius: the directory setup.sh --cyrius installs (tools/cyrius-<version>)
    parascopy_data     = null       // parascopy: homology table and models (setup.sh --parascopy-data: reference/parascopy-<version>)
    parascopy_population = 'EUR'    // parascopy: model of AFR, AMR, EAS, EUR or SAS
    parascopy_depth_bed = null      // parascopy: background windows of one size, for a BAM that covers part of the genome
    yleaf_data         = null       // y_haplogroup: Yleaf's marker tables and tree (setup.sh --yleaf-data: reference/yleaf-<version>/data)
    slivar_bin         = null       // Deprecated and ignored: slivar runs from SLIVAR_IMAGE; dropped next release

    // ── Resource limits ─────────────────────────────────────────────────
    max_memory         = '64.GB'
    max_cpus           = 16
    max_time           = '48.h'
}

// Load base resource config
includeConfig 'conf/base.config'

// Container image of every process: one withName selector each, generated
// from versions.env by scripts/ci/gen-containers-config.sh
includeConfig 'conf/containers.config'

// Report-only tools: nothing downstream needs their output but the report,
// whose joins keep a sample whose step is missing (remainder: true). A task
// killed for memory or time is retried once, as conf/base.config does for
// every process; any other failure is ignored, so the run goes on to
// DeepVariant and the report instead of stopping. MITO_VARIANTS feeds the mito
// haplogroup through such a join (without it the haplogroup comes from the
// VCF) and haplocheck, which only reads Mutect2's calls. main.nf's completion
// handler names every ignored task and writes failed_tasks.tsv, and run-all.sh
// marks its step failed. HLA_TYPING (PharmCAT), CYP2D6_DEPTH (pypgx, Cyrius),
// MOSDEPTH (MultiQC) and the SV callers (SURVIVOR) feed other steps and keep
// the stop. A withName setting wins over base.config's process-wide one. The
// exit-code list is the one in conf/base.config's errorStrategy: change both.
process {
    withName: 'TELOMERE_HUNTER|EXPANSION_HUNTER|STRANGER|MITO_VARIANTS|ANNOTSV|CPSR|Y_POSITIONS|Y_PILEUP|Y_HAPLOGROUP|MULTIQC' {
        errorStrategy = { task.exitStatus in [143,137,104,134,139,247] && task.attempt == 1 ? 'retry' : 'ignore' }
    }
}

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '--user root:root'
        docker.fixOwnership    = true
        singularity.enabled    = false
        conda.enabled          = false
        // No network inside a container: the analysis reads only its inputs,
        // so a tool that reaches out at run time fails loudly instead of
        // downloading something unpinned. No exception: Cyrius runs from the
        // install setup.sh --cyrius made.
        process.containerOptions = '--network none'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test_full.config'
    }
    test_all {
        includeConfig 'conf/test_all.config'
    }
}

// Execution reports
// Timestamp is inlined into each file path: the strict Nextflow config
// parser disallows top-level 'def'/variable declarations, but still
// evaluates expressions inside GString interpolation. Format matches the
// previous "yyyy-MM-dd_HH-mm-ss" naming exactly.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new Date())}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new Date())}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new Date())}.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag_${new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new Date())}.svg"
}

// Manifest
manifest {
    name            = 'Personal-Genome-Pipeline'
    author          = 'GeiserX'
    homePage        = 'https://github.com/GeiserX/Personal-Genome-Pipeline'
    description     = 'Whole genome sequencing from FASTQ, BAM or VCF to clinical interpretation'
    mainScript      = 'main.nf'
    // Validated on the Nextflow release pinned in versions.env (NEXTFLOW_VERSION)
    // and on the newest 26.04.x (both legs of .github/workflows/nextflow.yml).
    // The floor rejects 24.x, whose vcfanno strict-parser regression breaks this
    // pipeline.
    nextflowVersion = '!>=25.10.4'
    version         = '0.8.2'
}
